{
    "$schema": "https://opencode.ai/config.json",
    "model": "openai/gpt-6-sol",
    "small_model": "openai/gpt-6-luna",
    "autoupdate": false,
    "share": "disabled",
    "enabled_providers": ["openai", "anthropic"],
    "plugin": [
        "./plugins/ponytail.mjs",
        "./plugins/lms-responses-compat.js"
    ],
    "provider": {
        "openai": {
            "name": "OpenAI",
            "env": ["OPENCODE_API_KEY"],
            "npm": "@ai-sdk/openai",
            "whitelist": [
                "gpt-6-sol",
                "gpt-6-luna",
                "gpt-6-astra",
                "gpt-5.6-sol",
                "gpt-5.6-terra",
                "gpt-5.6-luna",
                "gpt-5.5",
                "gpt-5.4",
                "gpt-5.4-mini",
                "gpt-5.4-nano",
                "gpt-5.3-codex",
                "gpt-5.2",
                "gpt-5.1",
                "gpt-5.1-codex",
                "gpt-5.1-codex-mini",
                "gpt-5",
                "gpt-5-codex",
                "gpt-5-mini",
                "gpt-5-nano",
                "gpt-4.1",
                "gpt-4.1-mini",
                "gpt-4.1-nano",
                "gpt-4o",
                "o3",
                "o4-mini",
                "codex-auto-review"
            ],
            "models": {
                "gpt-6-sol": {
                    "id": "gpt-6-sol",
                    "name": "GPT-6 Sol",
                    "limit": { "context": 1050000, "output": 128000 }
                },
                "gpt-6-luna": {
                    "id": "gpt-6-luna",
                    "name": "GPT-6 Luna",
                    "limit": { "context": 1050000, "output": 128000 }
                },
                "gpt-6-astra": {
                    "id": "gpt-6-astra",
                    "name": "GPT-6 Astra",
                    "limit": { "context": 1050000, "output": 128000 }
                },
                "gpt-5.6-sol": { "id": "gpt-5.6-sol", "name": "GPT-5.6 Sol" },
                "gpt-5.6-luna": {
                    "id": "gpt-5.6-luna",
                    "name": "GPT-5.6 Luna"
                },
                "gpt-5.6-terra": {
                    "id": "gpt-5.6-terra",
                    "name": "GPT-5.6 Terra"
                },
                "gpt-5.5": {
                    "id": "gpt-5.5",
                    "name": "GPT-5.5",
                    "limit": { "context": 1050000, "output": 128000 }
                },
                "gpt-5.4": { "id": "gpt-5.4", "name": "GPT-5.4" },
                "gpt-5.4-mini": {
                    "id": "gpt-5.4-mini",
                    "name": "GPT-5.4 mini"
                },
                "gpt-5.4-nano": {
                    "id": "gpt-5.4-nano",
                    "name": "GPT-5.4 nano"
                },
                "gpt-5.3-codex": {
                    "id": "gpt-5.3-codex",
                    "name": "GPT-5.3 Codex"
                },
                "gpt-5.2": { "id": "gpt-5.2", "name": "GPT-5.2" },
                "gpt-5.1": { "id": "gpt-5.1", "name": "GPT-5.1" },
                "gpt-5.1-codex": {
                    "id": "gpt-5.1-codex",
                    "name": "GPT-5.1 Codex"
                },
                "gpt-5.1-codex-mini": {
                    "id": "gpt-5.1-codex-mini",
                    "name": "GPT-5.1 Codex mini"
                },
                "gpt-5": { "id": "gpt-5", "name": "GPT-5" },
                "gpt-5-codex": { "id": "gpt-5-codex", "name": "GPT-5 Codex" },
                "gpt-5-mini": { "id": "gpt-5-mini", "name": "GPT-5 mini" },
                "gpt-5-nano": { "id": "gpt-5-nano", "name": "GPT-5 nano" },
                "gpt-4.1": { "id": "gpt-4.1", "name": "GPT-4.1" },
                "gpt-4.1-mini": {
                    "id": "gpt-4.1-mini",
                    "name": "GPT-4.1 mini"
                },
                "gpt-4.1-nano": {
                    "id": "gpt-4.1-nano",
                    "name": "GPT-4.1 nano"
                },
                "gpt-4o": { "id": "gpt-4o", "name": "GPT-4o" },
                "o3": { "id": "o3", "name": "o3" },
                "o4-mini": { "id": "o4-mini", "name": "o4-mini" },
                "codex-auto-review": {
                    "id": "codex-auto-review",
                    "name": "Codex Auto Review",
                    "limit": { "context": 400000, "output": 128000 }
                }
            },
            "options": {
                "baseURL": "{env:OPENCODE_BASE_URL}/api/v2/llm/proxy/openai/v1",
                "apiKey": "no-api-key",
                "timeout": false,
                "headerTimeout": 60000,
                "headers": { "Authorization": "Bearer {env:OPENCODE_API_KEY}" }
            }
        },
        "anthropic": {
            "name": "Anthropic",
            "env": ["OPENCODE_API_KEY"],
            "whitelist": [
                "claude-haiku-4-5",
                "claude-opus-4-1",
                "claude-opus-4-5",
                "claude-opus-4-6",
                "claude-opus-4-7",
                "claude-opus-4-8",
                "claude-opus-5",
                "claude-opus-5-5",
                "claude-sonnet-4-5",
                "claude-sonnet-4-6"
            ],
            "models": {
                "claude-haiku-4-5": {
                    "id": "claude-haiku-4-5",
                    "name": "Claude Haiku 4.5",
                    "modalities": {
                        "input": ["text", "image", "pdf"],
                        "output": ["text"]
                    },
                    "options": {
                        "thinking": { "type": "enabled", "budgetTokens": 4000 }
                    }
                },
                "claude-opus-4-1": {
                    "id": "claude-opus-4-1",
                    "name": "Claude Opus 4.1",
                    "modalities": {
                        "input": ["text", "image", "pdf"],
                        "output": ["text"]
                    },
                    "options": {
                        "thinking": { "type": "enabled", "budgetTokens": 16000 }
                    }
                },
                "claude-opus-4-5": {
                    "id": "claude-opus-4-5",
                    "name": "Claude Opus 4.5",
                    "modalities": {
                        "input": ["text", "image", "pdf"],
                        "output": ["text"]
                    },
                    "options": {
                        "thinking": { "type": "enabled", "budgetTokens": 16000 }
                    }
                },
                "claude-opus-4-6": {
                    "id": "claude-opus-4-6",
                    "name": "Claude Opus 4.6",
                    "modalities": {
                        "input": ["text", "image", "pdf"],
                        "output": ["text"]
                    },
                    "options": {
                        "thinking": { "type": "enabled", "budgetTokens": 16000 }
                    }
                },
                "claude-opus-4-7": {
                    "id": "claude-opus-4-7",
                    "name": "Claude Opus 4.7",
                    "modalities": {
                        "input": ["text", "image", "pdf"],
                        "output": ["text"]
                    }
                },
                "claude-opus-4-8": {
                    "id": "claude-opus-4-8",
                    "name": "Claude Opus 4.8",
                    "modalities": {
                        "input": ["text", "image", "pdf"],
                        "output": ["text"]
                    }
                },
                "claude-opus-5": {
                    "id": "claude-opus-5",
                    "name": "Claude Opus 5",
                    "limit": { "context": 1000000, "output": 128000 },
                    "modalities": {
                        "input": ["text", "image", "pdf"],
                        "output": ["text"]
                    }
                },
                "claude-opus-5-5": {
                    "id": "claude-opus-5-5",
                    "name": "Claude Opus 5.5",
                    "limit": { "context": 1000000, "output": 128000 },
                    "modalities": {
                        "input": ["text", "image", "pdf"],
                        "output": ["text"]
                    }
                },
                "claude-sonnet-4-5": {
                    "id": "claude-sonnet-4-5",
                    "name": "Claude Sonnet 4.5",
                    "modalities": {
                        "input": ["text", "image", "pdf"],
                        "output": ["text"]
                    },
                    "options": {
                        "thinking": { "type": "enabled", "budgetTokens": 16000 }
                    }
                },
                "claude-sonnet-4-6": {
                    "id": "claude-sonnet-4-6",
                    "name": "Claude Sonnet 4.6",
                    "modalities": {
                        "input": ["text", "image", "pdf"],
                        "output": ["text"]
                    },
                    "options": {
                        "thinking": { "type": "enabled", "budgetTokens": 16000 }
                    }
                }
            },
            "options": {
                "baseURL": "{env:OPENCODE_BASE_URL}/api/v2/llm/proxy/anthropic/v1",
                "apiKey": "no-api-key",
                "timeout": false,
                "headers": { "Authorization": "Bearer {env:OPENCODE_API_KEY}" }
            }
        }
    },
    "permission": {
        "bash": "ask",
        "edit": "allow",
        "lsp": "allow"
    },
    "lsp": {
        // TypeScript / JavaScript (requires typescript-language-server installed)
        "typescript-language-server": {
            "command": ["typescript-language-server", "--stdio"],
            "extensions": [".ts", ".tsx", ".js", ".jsx"]
        },
        // C / C++ (requires clangd installed)
        "clangd": {
            "command": ["clangd", "--background-index", "--clang-tidy"],
            "extensions": [".c", ".h", ".cpp", ".hpp"]
        },
        // Rust (requires rust-analyzer installed)
        "rust-analyzer": {
            "command": ["rust-analyzer"],
            "extensions": [".rs"]
        },
        // Python (requires pyright installed)
        "pyright": {
            "command": ["pyright-langserver", "--stdio"],
            "extensions": [".py"]
        },
        // PHP (requires intelephense installed)
        "intelephense": {
            "command": ["intelephense", "--stdio"],
            "extensions": [".php"]
        }
    },
    "mcp": {
        "palantir": {
            "type": "local",
            "command": [
                "sh",
                "-c",
                "FOUNDRY_TOKEN=\"$OPENCODE_API_KEY\" exec npx -y palantir-mcp --foundry-api-url \"$OPENCODE_BASE_URL\""
            ],
            "enabled": false
        }
    }
}
